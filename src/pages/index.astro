---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Header from "@/components/toppage/Header.astro";
import About from "@/components/toppage/About.astro";
import Contacts from "@/components/toppage/Contacts.astro";
import Featured from "@/components/toppage/Featured.astro";
import BlogLinks from "@/components/toppage/BlogLinks.astro";
---

<Layout>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <Header />
    <Section title="About">
      <About />
      <Contacts />
    </Section>
    <Featured />
    <BlogLinks />
  </main>
</Layout>
