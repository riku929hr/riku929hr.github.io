---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  link: string;
  bgColor: string;
  icon: string;
  iconClass: string;
  description?: string;
  badge?: string;
  date?: string;
}

const { name, link, bgColor, icon, iconClass, description, badge, date } =
  Astro.props;
---

<li class="h-full">
  <a
    href={link}
    class={`${bgColor} flex h-full min-h-16 w-full flex-row rounded-lg transition hover:text-gray-500`}
  >
    <div class="flex w-20 items-center justify-center">
      <Icon name={icon} class={iconClass} />
    </div>
    <div class="w-full content-center py-2">
      <div class="flex flex-wrap items-center gap-2">
        <p class="font-bold">{name}</p>
        {
          badge && (
            <span class="rounded-full bg-white/60 px-2 py-0.5 text-xs">
              {badge}
            </span>
          )
        }
        {date && <span class="text-xs text-gray-500">{date}</span>}
      </div>
      {description && <p class="text-sm">{description}</p>}
    </div>
  </a>
</li>
