---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  link: string;
  bgColor: string;
  icon: string;
  iconClass: string;
  description?: string;
}

const { name, link, bgColor, icon, iconClass, description } = Astro.props;
---

<li class="my-4">
  <a
    href={link}
    class={`${bgColor} flex h-16 w-full flex-row rounded-lg hover:text-gray-500`}
  >
    <div class="flex w-20 items-center justify-center">
      <Icon name={icon} class={iconClass} />
    </div>
    <div class="w-full content-center">
      <p class="font-bold">{name}</p>
      {description && <p class="text-sm">{description}</p>}
    </div>
  </a>
</li>
