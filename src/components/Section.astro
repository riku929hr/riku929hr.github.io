---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="py-8">
  <div class="flex items-center gap-2">
    <span
      class="h-5 w-1 rounded-full bg-gradient-to-b from-[#399918] to-[#F6FB7A]"
    ></span>
    <h2 class="text-xl font-bold tracking-tight">{title}</h2>
  </div>
  <div class="mt-4">
    <slot />
  </div>
</section>
